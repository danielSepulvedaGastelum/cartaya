# Copia este archivo como .env y reemplaza los valores en producción.
# Nunca uses variables con prefijo VITE_ para secretos: Vite las expone al navegador.
ESTABLECIMIENTO_PASSWORD=cambia-esta-contrasena
SESSION_SECRET=cambia-este-secreto-largo
SQLITE_PATH=./data/cartaya.sqlite
MEDIA_DIR=./media
MESAS=barra,ventana,patio-1,patio-2
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Usa la zona horaria local del establecimiento para el histórico y el cierre de sesión.
TZ=America/Hermosillo
